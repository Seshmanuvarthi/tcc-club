# ─── Admin login ────────────────────────────────────────────────
# Username the admin uses to log in. Plain text, no quotes needed.
ADMIN_USER=admin

# bcrypt hash of the admin password.
#
# ⚠️  IMPORTANT: a bcrypt hash starts with "$2a$10$..." and contains
# "$" characters. In a Next.js .env.local file, "$" triggers variable
# expansion. Quoting does NOT prevent this — you MUST escape each "$"
# with a backslash.
#
# Steps:
#   1. Generate the hash:
#        node -e "console.log(require('bcryptjs').hashSync('YOUR-PASSWORD', 10))"
#   2. Replace every "$" in the output with "\$" before pasting below.
#
# Example (hash for password "demo"):
#   ADMIN_PASSWORD_HASH=\$2a\$10\$1234567890abcdefghijklmno
#
# When deployed on Vercel, env vars are set in the dashboard and do NOT
# need any escaping — paste the raw hash there.
ADMIN_PASSWORD_HASH=

# 32+ character random string used to sign the session cookie.
# Hex output contains no "$" so no escaping is needed.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# ─── Vercel Blob ────────────────────────────────────────────────
# Read/write token from your Vercel project's Storage → Blob settings.
# Token format is alphanumeric+underscores so no escaping is needed.
# Without this token, the Daily Menu and Newsletter uploads will fail.
BLOB_READ_WRITE_TOKEN=
