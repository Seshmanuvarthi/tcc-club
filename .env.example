# ─── Admin login ────────────────────────────────────────────────
# Username the admin uses to log in
ADMIN_USER=admin

# bcrypt hash of the admin password.
# Generate one locally with:
#   node -e "console.log(require('bcryptjs').hashSync('YOUR-PASSWORD', 10))"
ADMIN_PASSWORD_HASH=\$2a\$10\$aE2j4.rRmq/YfKsmVl4AUuzDJDl4.T/vddLbgl8q1P35GPoB1m0LG

# 32+ character random string used to sign the session cookie.
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=406b58c4ca3d0f61527c46653edcc427bf7d81ff9cf068224dde5760f55fb07f

# ─── Vercel Blob ────────────────────────────────────────────────
# Read/write token from your Vercel project's Storage → Blob settings.
# Without this token, the Daily Menu and Newsletter uploads will fail.
BLOB_READ_WRITE_TOKEN="vercel_blob_rw_x8KbqNHsbpTxCTo2_rcUDeLabXyitYQa5VH4UwJwalJifi8"